---
componentName:  mikuos


### WELCOME / OVERALL WORDING

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true

### WINDOW CONFIGURATION

windowExpanding:    normal
windowSize: 900px,600px
windowPlacement: center

### PANELS CONFIGURATION

sidebar: widget
navigation: widget


### STRINGS, IMAGES AND COLORS

strings:
    productName:         "${PRETTY_NAME}"
    shortProductName:    MiKuOS
    version:
    shortVersion:
    versionedName:       "${PRETTY_NAME}"
    shortVersionedName:  MiKuOS
    bootloaderEntryName: MiKuOS
    productUrl:          https://mikuos.local/
    supportUrl:          https://mikuos.local/support
    knownIssuesUrl:      https://github.com/mikuos/mikuos/issues
    releaseNotesUrl:     https://mikuos.local/manual

images:
    productIcon:         "logo.png"
    productLogo:         "logo.png"
    productWelcome:      "miku-cosmic-night.jpg"

style:
   SidebarBackground:        "#101c30"
   SidebarText:              "#c3d4f2"
   SidebarTextCurrent:       "#101c30"
   SidebarBackgroundCurrent: "#39c5bb"

### SLIDESHOW

slideshow:               "show.qml"
slideshowAPI: 2


### LOG UPLOAD

uploadServer:
    type :    "fiche"
    url :     "http://termbin.com:9999"
    sizeLimit : -1